# Репозиторий публичный: в нём лежит только то, что скрипты загружают по прямой
# ссылке во время игры (raw.githubusercontent.com / cdn.jsdelivr.net), и то, без
# чего эти файлы не работают. Всё остальное — локально и в коммиты не попадает.
# Новый публичный файл добавляется сюда строкой "!/путь" (для папки — ещё и "!/папка/").

/*
!/.gitignore

# Загружаются по прямой ссылке
!/leaderboard.lua
!/Catalog.lua

# Модули, которые лидерборд тянет по ссылке (CONFIG.Modules, GUIFactory)
!/Libraryes/
/Libraryes/*
!/Libraryes/GUI.lua
!/Libraryes/Optimization.lua

# Emotes и то, что он подгружает с jsDelivr (SafeLoad)
!/Scripts/
/Scripts/*
!/Scripts/Emotes.lua
!/Scripts/Notify.lua
!/Scripts/Settings.lua
!/Scripts/OpenEmote.lua
!/Scripts/count-emote
