[Unit]
Description=Violite sessions and private control panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=violite
Group=violite
WorkingDirectory=/opt/violite-control/current
Environment=VIOLITE_CONFIG=/etc/violite-control/config.json
ExecStart=/opt/violite-control/node/bin/node /opt/violite-control/current/control-server/server.js
Restart=on-failure
RestartSec=3
UMask=0077
StateDirectory=violite-control
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/violite-control
MemoryMax=384M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
